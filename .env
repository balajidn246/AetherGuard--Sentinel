# AetherGuard--Sentinel Configuration

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION
LOG_LEVEL=INFO

# PostgreSQL (Transactional Data: Users, Incidents, IOCs, Config)
POSTGRES_USER=aetherguard
POSTGRES_PASSWORD=aetherguard_secure_2024
POSTGRES_DB=aetherguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aetherguard:aetherguard_secure_2024@localhost:5432/aetherguard

# ClickHouse (Analytical Data: Events, Alerts, Signals)
CLICKHOUSE_USER=aetherguard
CLICKHOUSE_PASSWORD=aetherguard_secure_2024
CLICKHOUSE_DB=aetherguard
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123

# Redis (Cache, Rate Limiting, Async Queues, Dev Transport)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Local AI (Ollama)
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:1b

# Grafana
GRAFANA_PASSWORD=admin
